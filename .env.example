# USDA FoodData Central API key — free at https://fdc.nal.usda.gov/api-key-signup
# Falls back to the rate-limited DEMO_KEY when unset (fine for development).
EXPO_PUBLIC_FDC_API_KEY=

# Supabase project (Project Settings → API). The anon key is public-facing
# and protected by row-level security. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to "false" to use the Supabase backend (requires the keys above).
EXPO_PUBLIC_USE_MOCK=true
