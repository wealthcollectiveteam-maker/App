# Supabase project (Project Settings → API). The anon key is public-facing
# and protected by row-level security. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Supabase backend is the DEFAULT — leave this unset for a real build.
# Set it to 1 (or "true") only to force the mock for offline UI work; the app
# then shows a permanent "Mock data" banner so the state is never a surprise.
# Missing keys above also fall back to the mock, with the same banner.
EXPO_PUBLIC_USE_MOCK=

# TEMPORARY — PHASE 12B. Set to 1 to include the read-only layout diagnostic
# panel (Settings → Layout debug) in the build. It exists only because the tab
# bar defect appears on a home-indicator iPhone in standalone mode and nowhere
# a headless browser can look. Leave it UNSET for every normal build: the
# module is then never required and is absent from the bundle. Delete this
# variable together with src/components/LayoutDebug.tsx once the tab bar is
# confirmed on device.
EXPO_PUBLIC_LAYOUT_DEBUG=
